{
  "name": "expense-tracker",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --no-bundle",
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.2",
    "svelte": "^5.43.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
