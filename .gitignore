# Root allowlist: private reports, photos, local data, builds, and archives stay out.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SETUP.md
!/ARCHITECTURE.md
!/.editorconfig
!/.prettierrc.json
!/.prettierignore
!/rustfmt.toml
!/index.html
!/package.json
!/package-lock.json
!/svelte.config.js
!/tsconfig.json
!/vite.config.ts
!/vitest.config.ts
!/src/
!/src-tauri/
!/scripts/
!/public/
!/resources/

node_modules/
target/
/src-tauri/gen/
.DS_Store
Thumbs.db
*.log
*.tmp
*.pending
.env
.env.*
*.pem
*.key

# Private documents/data wherever they occur in allowed directories.
data/
backups/
transactions.json
settings.json
*inspection*.json
*.xlsx
*.xls
*.xlsm
*.xlsb
*.ods
*.csv
*.tsv
*.pdf
*.docx
*.zip
*.exe
*.dll
*.jpg
*.jpeg
*.webp
*.heic
*.heif
*.gif
*.mp4
*.mov
*.png

# Only known generated, non-personal images.
!/public/receipt-fixtures/japanese.png
!/public/receipt-fixtures/english.png
!/public/receipt-fixtures/mixed.png
!/src-tauri/icons/*.png
!/src-tauri/icons/**/*.png

# Private local workbook/receipt regression tools and examples.
/src/lib/private-workbook.test.ts
/scripts/reconciliation_report.py
/scripts/diagnose-webcam.mjs
/scripts/diagnose-webcam-browser.mjs
/scripts/receipt-diagnostic-variants.py
